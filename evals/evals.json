      "prompt": "用半调海报做一张关于凌晨便利店的竖版海报，文案是 still open。",
      "assertions": {
        "ratio": "3:4",
        "mechanism": "am_halftone",
        "ground": "ground_neutral_white",
        "mode": "complementary_duotone",
        "ink_hexes": ["#2148B8", "#C65F38"],
        "theme_roles": ["acc: main scene+headline", "accent: one object or overprint"],
        "volume": "image_lead",
        "behavior": "still",
        "empty_paper_range": [25, 55],
        "tonal_gate": "can name the ink, the angle, and where paper shows"
      }
    },
    {
