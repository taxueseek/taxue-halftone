    "mist": {
      "name": "Mist 雾阶",
      "percent_range": [0, 30],
      "duty": "主墨的浅阶或叠印密度，制造层次而不再加一色",
      "note": "Mist 不是第三色相；它通过同族浅阶或叠印实现层次"
    },
    "jump": {
      "name": "跳色（imperfect_collage 专属）",
      "percent_range": [0, 5],
      "duty": "一处小面积揭示、一处叠印交叉或高光点缀，不进主体结构",
      "note": "仅 imperfect_collage 风格的第三色通道；面积 ≤5%，须写 HEX；其他风格第三色仍只来自 overprint 混色"
    }
  },
  "defaults": {
    "substrate_id": "ground_neutral_white",
    "primary_percent": [70, 85],
    "accent_percent": [15, 30],
    "one_ink_when": ["明确单墨请求", "明确单色请求", "点名一支墨而未提第二色"],
