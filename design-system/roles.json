  "ink_roles": {
    "primary": {
      "name": "Ink 主墨",
      "percent_range": [70, 85],
      "duty": "承担主体结构、主标题、主要刻线",
      "note": "主墨承载画面主体的结构与主要文本，占印刷面积多数"
    },
    "accent": {
      "name": "辅墨",
      "percent_range": [15, 30],
      "duty": "只承担一个具体职务：日期、注释、一个物件、一处叠印交叉",
